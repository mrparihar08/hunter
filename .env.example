# ==============================================================================
# PERSONAL CLIENT HUNTING TOOL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Supabase / PostgreSQL Database Connection
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Note: For Supabase, use the Transaction / Session connection pooler URL or direct PostgreSQL connection string.
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@your-supabase-host:5432/postgres

# Google Gemini API (Required for AI Qualification & Outreach Drafts)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Google Places API (Optional - Activates Places search when provided)
# Set to empty string if using manual deep links first
GOOGLE_PLACES_API_KEY=

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
